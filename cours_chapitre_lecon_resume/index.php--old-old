<script>
function openAddLeconModal(chapId) {
    document.getElementById('modal_chapitre_id').value = chapId;
    new bootstrap.Modal(document.getElementById('addLeconModal')).show();
}

function openEditChapModal(chap) {
    document.getElementById('edit_chapitre_id').value = chap.id;
    document.getElementById('edit_chap_titre').value = chap.titre;
    document.getElementById('edit_chap_cours_id').value = chap.cours_id;
    document.getElementById('edit_chap_classe_id').value = chap.classe_id;
    document.getElementById('edit_chap_prof_id').value = chap.prof_id;
    new bootstrap.Modal(document.getElementById('editChapModal')).show();
}

function openEditLeconModal(lecon) {
    document.getElementById('edit_lecon_id').value = lecon.id;
    document.getElementById('edit_lecon_titre').value = lecon.titre;
    document.getElementById('edit_lecon_type_format').value = lecon.type_format;
    document.getElementById('edit_lecon_contenu').value = lecon.contenu || '';
    document.getElementById('edit_lecon_description').value = lecon.description || '';

    const fileInfo = document.getElementById('current_file_info');
    if (lecon.fichier) {
        fileInfo.innerHTML = 'Fichier actuel : <strong>' + lecon.fichier + '</strong>';
    } else {
        fileInfo.innerHTML = 'Aucun fichier rattaché.';
    }

    new bootstrap.Modal(document.getElementById('editLeconModal')).show();
}

function toggleResume(id, btn) {
    const box = document.getElementById('resume_box_' + id);
    if (box.classList.contains('resume-collapsed')) {
        box.classList.remove('resume-collapsed');
        box.classList.add('resume-expanded');
        btn.innerHTML = 'Voir moins ☝️';
    } else {
        box.classList.remove('resume-expanded');
        box.classList.add('resume-collapsed');
        btn.innerHTML = 'Voir plus 👇';
    }
}
</script>

